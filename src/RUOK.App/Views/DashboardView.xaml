<UserControl
    x:Class="RUOK_App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:RUOK_App.Resources"
    xmlns:vm="using:RUOK_App.ViewModels"
    xmlns:controls="using:RUOK_App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="28,20,28,32" MaxWidth="1040" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ui:UiText.Get('DashboardTitle')}" Style="{StaticResource PageHeading}" />
                <TextBlock Text="{x:Bind ui:UiText.Get('DashboardSubtitle')}" Style="{StaticResource BodyCopy}" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceCard}" Padding="28">
                <Grid ColumnSpacing="24" SizeChanged="HeroSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind ui:UiText.Get('HeroTitle')}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ui:UiText.Get('HeroBody')}" Style="{StaticResource BodyCopy}" />
                        <Button Content="{x:Bind ui:UiText.Get('StartPulse')}" Command="{x:Bind ViewModel.OpenPulseCommand}"
                                Style="{StaticResource AccentButtonStyle}" MinHeight="44" Margin="0,4,0,0" />
                        <HyperlinkButton Content="{x:Bind ui:UiText.Get('StartBreathing')}" Command="{x:Bind ViewModel.OpenBreathingCommand}" />
                    </StackPanel>
                    <controls:MoodFace x:Name="HeroFace" Grid.Column="1" Width="88" Height="88" Score="4" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid x:Name="MetricGrid" RowSpacing="12" ColumnSpacing="12" SizeChanged="MetricsSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border x:Name="AverageCard" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ui:UiText.Get('WeeklyAverage')}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.AverageMood, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ui:UiText.Get('AverageScale')}" Style="{StaticResource BodyCopy}" />
                    </StackPanel>
                </Border>
                <Border x:Name="CountCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ui:UiText.Get('WeeklyCount')}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.WeeklyCount, Mode=OneWay}" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ui:UiText.Get('CountHint')}" Style="{StaticResource BodyCopy}" />
                    </StackPanel>
                </Border>
                <Border x:Name="LatestCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ui:UiText.Get('LatestMood')}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.LatestMood, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ui:UiText.Get('LatestHint')}" Style="{StaticResource BodyCopy}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ui:UiText.Get('DistributionTitle')}" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{x:Bind ui:UiText.Get('DistributionDescription')}" Style="{StaticResource BodyCopy}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Distribution}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DistributionRow">
                                <Grid ColumnSpacing="12" Margin="0,8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" /><ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <controls:MoodFace Score="{x:Bind Score}" Width="30" Height="30" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ProgressBar Grid.Column="2" Value="{x:Bind Count}" Maximum="{x:Bind Maximum}"
                                                 VerticalAlignment="Center" AutomationProperties.Name="{x:Bind AccessibleName}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Count}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ui:UiText.Get('AverageExplanation')}" Style="{StaticResource BodyCopy}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
