<UserControl
    x:Class="RUOK_App.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:RUOK_App.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="28,20,28,32" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind ui:UiText.Get('AboutTitle')}" Style="{StaticResource PageHeading}" />
            <Border Style="{StaticResource SurfaceCard}">
                <TextBlock Text="{x:Bind ui:UiText.Get('Disclaimer')}" TextWrapping="Wrap" FontSize="17" />
            </Border>
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ui:UiText.Get('ResourceTitle')}" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{x:Bind ui:UiText.Get('ResourceBody')}" Style="{StaticResource BodyCopy}" />
                    <TextBlock Text="{x:Bind ui:UiText.Get('ResourceDeferred')}" Style="{StaticResource BodyCopy}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ui:UiText.Get('PhaseNotice')}" Style="{StaticResource BodyCopy}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
