<UserControl
    x:Class="RUOK_App.Controls.MoodFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox>
        <Grid Width="52" Height="52">
            <Ellipse x:Name="FaceRing" Width="46" Height="46" StrokeThickness="2.5"
                     Stroke="{ThemeResource TextFillColorPrimaryBrush}" />
            <Ellipse Width="4" Height="4" Margin="16,17,0,0" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Ellipse Width="4" Height="4" Margin="32,17,0,0" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="15,33">
                            <QuadraticBezierSegment x:Name="MouthCurve" Point1="26,33" Point2="37,33" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
